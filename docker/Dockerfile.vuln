FROM ubuntu:22.04
RUN apt-get update && apt-get install -y openssh-server libpam-pwquality jq \
    && rm -rf /var/lib/apt/lists/*
# U-01 취약: root 원격접속 허용
RUN echo 'PermitRootLogin yes' >> /etc/ssh/sshd_config
# U-02 취약: 최소 길이 4
RUN echo 'minlen = 4' >> /etc/security/pwquality.conf
# U-03 취약: 계정 잠금 임계값 과도하게 높게 설정 (= 미설정과 동일 효과)
RUN mkdir -p /etc/security && echo 'deny = 99' >> /etc/security/faillock.conf
# U-05 취약: root 외 UID 0 계정
RUN useradd -o -u 0 -g 0 -M -s /bin/bash backdoor
# U-14 취약: root 프로필 PATH 맨 앞에 "." 포함
RUN echo 'export PATH=.:$PATH' >> /root/.bashrc
# U-15 취약: 소유자 없는 파일 (UID 54321 은 passwd 에 없음)
RUN touch /var/orphan.txt && chown 54321:54321 /var/orphan.txt
# U-16 취약: /etc/passwd 권한 과다
RUN chmod 666 /etc/passwd
# U-17 취약: 시작 스크립트 others 쓰기 허용
RUN printf '#!/bin/sh\nexit 0\n' > /etc/init.d/badsvc && chmod 777 /etc/init.d/badsvc
# U-18 취약: /etc/shadow 권한 과다
RUN chmod 644 /etc/shadow
# U-19 취약: finger 서비스 활성화 설정
RUN mkdir -p /etc/xinetd.d && printf 'service finger\n{\n  disable = no\n}\n' > /etc/xinetd.d/finger
# U-20 취약: hosts.equiv에 신뢰 호스트(+) 등록
RUN echo '+' > /etc/hosts.equiv
# U-21 취약: Anonymous FTP 허용
RUN echo 'anonymous_enable=YES' >> /etc/vsftpd.conf
# U-22 취약: SNMP community string 기본값(public) 사용
RUN mkdir -p /etc/snmp && echo 'rocommunity public' >> /etc/snmp/snmpd.conf
# U-23 취약: NFS 전체 공개 + no_root_squash
RUN echo '/export *(rw,no_root_squash)' >> /etc/exports
COPY . /opt/checker
WORKDIR /opt/checker
CMD ["bash", "run_all.sh"]
